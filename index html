<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Velour Coffee — Portland, Oregon</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap">
<style>
/* ═══════════════════════════════
   TOKENS
═══════════════════════════════ */
:root{
  --bg:#0f0d0a;
  --bg2:#181410;
  --bg3:#221d16;
  --bg4:#2d261d;
  --cream:#f5ede0;
  --cream2:#e8d9c4;
  --cream3:#c8b89a;
  --brown:#8b5e3c;
  --brown2:#a3714a;
  --amber:#d4860e;
  --amber2:#f0a830;
  --green:#2d4a3e;
  --green2:#3d6b5a;
  --border:rgba(212,134,14,.12);
  --border2:rgba(212,134,14,.07);
  --dis:'Playfair Display',Georgia,serif;
  --body:'DM Sans',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--cream);font-family:var(--body);font-weight:300;overflow-x:hidden;line-height:1.6}
img{display:block;max-width:100%;object-fit:cover}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font-family:var(--body)}

/* ═══════════════════════════════
   SCROLL & UTILS
═══════════════════════════════ */
#prog{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--brown),var(--amber),var(--amber2));z-index:300;transition:width .05s}
#btt{position:fixed;bottom:2rem;right:2rem;width:46px;height:46px;background:var(--amber);color:var(--bg);border:none;font-size:1.1rem;cursor:pointer;opacity:0;pointer-events:none;transition:.3s;z-index:50;display:flex;align-items:center;justify-content:center}
#btt.show{opacity:1;pointer-events:all}
#btt:hover{background:var(--amber2);transform:translateY(-3px)}

/* ═══════════════════════════════
   PRELOADER
═══════════════════════════════ */
#loader{position:fixed;inset:0;background:var(--bg);z-index:999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;transition:opacity .9s .3s,visibility .9s .3s}
#loader.gone{opacity:0;visibility:hidden}
.ld-cup{font-size:3rem;animation:steam 1.5s ease-in-out infinite}
@keyframes steam{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-8px) rotate(3deg)}}
.ld-name{font-family:var(--dis);font-size:1.8rem;color:var(--amber);letter-spacing:.2em;font-weight:400}
.ld-bar{width:180px;height:2px;background:var(--border);overflow:hidden;border-radius:1px}
.ld-bar::after{content:'';display:block;height:100%;background:linear-gradient(90deg,var(--brown),var(--amber));animation:ldp 1.4s ease forwards}
@keyframes ldp{from{width:0}to{width:100%}}

/* ═══════════════════════════════
   MARQUEE
═══════════════════════════════ */
.mq-wrap{background:var(--amber);overflow:hidden;padding:.45rem 0}
.mq-track{display:flex;white-space:nowrap;animation:mq 25s linear infinite}
.mq-track span{padding:0 2rem;font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--bg);font-weight:600}
.mq-track .sep{padding:0;opacity:.4;font-size:.5rem}
@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ═══════════════════════════════
   NAV
═══════════════════════════════ */
header{position:sticky;top:0;z-index:90;transition:.4s}
header.sc{background:rgba(15,13,10,.96);backdrop-filter:blur(20px);border-bottom:1px solid var(--border2);box-shadow:0 4px 32px rgba(0,0,0,.5)}
.nav-w{max-width:1360px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:1.3rem 2.5rem;gap:2rem}
.logo{display:flex;align-items:center;gap:.7rem}
.logo-cup{font-size:1.5rem}
.logo-text{font-family:var(--dis);font-size:1.4rem;font-weight:400;color:var(--amber);letter-spacing:.08em;line-height:1}
.logo-text small{display:block;font-family:var(--body);font-size:.45rem;letter-spacing:.4em;text-transform:uppercase;color:var(--cream3);font-weight:400;margin-top:2px}
nav{display:flex;gap:2.2rem}
nav a{font-size:.65rem;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--cream3);transition:.2s;position:relative;padding-bottom:3px}
nav a::after{content:'';position:absolute;bottom:0;left:0;width:0;height:1px;background:var(--amber);transition:.3s}
nav a:hover{color:var(--amber)}
nav a:hover::after{width:100%}
.nav-cta{background:var(--amber);color:var(--bg);border:none;padding:.6rem 1.6rem;font-size:.62rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:.25s;white-space:nowrap}
.nav-cta:hover{background:var(--amber2)}
.ham{display:none;flex-direction:column;gap:5px;padding:4px;cursor:pointer}
.ham span{width:22px;height:1px;background:var(--cream3);display:block;transition:.3s}

/* ═══════════════════════════════
   MOB NAV
═══════════════════════════════ */
.mob{position:fixed;inset:0;background:var(--bg);z-index:85;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2.5rem;transform:translateX(100%);transition:transform .5s cubic-bezier(.77,0,.18,1)}
.mob.open{transform:none}
.mob a{font-family:var(--dis);font-size:2.8rem;font-weight:300;color:var(--cream3);transition:.2s}
.mob a:hover{color:var(--amber)}
#mobX{position:absolute;top:1.8rem;right:2rem;background:none;border:none;font-size:1.3rem;color:var(--cream3);cursor:pointer;transition:.2s}
#mobX:hover{color:var(--amber)}

/* ═══════════════════════════════
   SECTION UTILS
═══════════════════════════════ */
.sec{padding:8rem 2.5rem}
.inn{max-width:1360px;margin:0 auto}
.ey{font-size:.58rem;letter-spacing:.5em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:.9rem}
.h2{font-family:var(--dis);font-size:clamp(2.4rem,4.5vw,4rem);font-weight:400;line-height:1.08;color:var(--cream)}
.h2 em{font-style:italic;color:var(--amber2)}
.aline{width:40px;height:2px;background:linear-gradient(90deg,var(--brown),var(--amber));margin:1rem 0}
.aline.c{margin-inline:auto}
.sub{color:var(--cream3);line-height:1.95;font-size:.9rem;max-width:520px}
.btn-amber{background:var(--amber);color:var(--bg);border:none;padding:.9rem 2.4rem;font-size:.7rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:.25s;display:inline-block}
.btn-amber:hover{background:var(--amber2);transform:translateY(-2px);box-shadow:0 8px 28px rgba(212,134,14,.3)}
.btn-out{background:transparent;border:1px solid var(--amber);color:var(--amber);padding:.9rem 2.4rem;font-size:.7rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:.25s;display:inline-block}
.btn-out:hover{background:var(--amber);color:var(--bg)}

/* ═══════════════════════════════
   REVEAL
═══════════════════════════════ */
.rv{opacity:0;transform:translateY(30px);transition:opacity .9s,transform .9s}
.rv.vis{opacity:1;transform:none}
.rl{opacity:0;transform:translateX(-30px);transition:opacity .9s,transform .9s}
.rl.vis{opacity:1;transform:none}
.rr{opacity:0;transform:translateX(30px);transition:opacity .9s,transform .9s}
.rr.vis{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rv,.rl,.rr{transition:none;opacity:1;transform:none}}

/* ═══════════════════════════════
   PAGE 1 — HERO
═══════════════════════════════ */
.hero{position:relative;height:100vh;min-height:650px;overflow:hidden;background:#080604}
.hero-slides{position:absolute;inset:0}
.slide{position:absolute;inset:0;opacity:0;background-size:cover;background-position:center;transition:opacity 2.5s}
.slide.on{opacity:1;animation:kbz 14s linear forwards}
@keyframes kbz{from{transform:scale(1.08)}to{transform:scale(1)}}
.hero-ov{position:absolute;inset:0;background:linear-gradient(165deg,rgba(0,0,0,.05) 0%,rgba(15,13,10,.75) 50%,rgba(15,13,10,.97) 100%)}
.hero-c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 2rem;z-index:2}
.h-eye{font-size:.58rem;letter-spacing:.55em;text-transform:uppercase;color:var(--amber);margin-bottom:2rem;opacity:0;animation:fu .9s .4s forwards}
.h-h1{font-family:var(--dis);font-size:clamp(3.5rem,9vw,8.5rem);font-weight:400;line-height:1;color:#fff;margin-bottom:1.5rem;opacity:0;animation:fu 1s .6s forwards}
.h-h1 em{font-style:italic;color:var(--amber2);display:block;font-size:.7em}
.h-p{font-size:1rem;color:rgba(255,255,255,.5);max-width:460px;line-height:1.9;margin-bottom:3rem;opacity:0;animation:fu .9s .8s forwards}
.h-btns{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;opacity:0;animation:fu .9s 1s forwards}
.hero-scroll{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;z-index:3;animation:bob 2.5s ease-in-out infinite}
.hero-scroll .ln{width:1px;height:48px;background:linear-gradient(to bottom,transparent,rgba(212,134,14,.5))}
.hero-scroll p{font-size:.5rem;letter-spacing:.4em;text-transform:uppercase;color:rgba(255,255,255,.2)}
.hero-dots{position:absolute;bottom:2.5rem;right:2.5rem;display:flex;gap:.5rem;z-index:3}
.hd{width:28px;height:2px;background:rgba(255,255,255,.18);cursor:pointer;transition:.3s}
.hd.on{background:var(--amber);width:44px}
/* hero badges */
.hero-badges{position:absolute;bottom:3rem;left:2.5rem;z-index:3;display:flex;flex-direction:column;gap:.6rem}
.hbadge{background:rgba(15,13,10,.75);backdrop-filter:blur(10px);border:1px solid var(--border);padding:.6rem 1rem;display:flex;align-items:center;gap:.6rem}
.hbadge-ic{font-size:1.1rem}
.hbadge-t{font-size:.62rem;color:var(--cream3);letter-spacing:.08em}
.hbadge-t strong{color:var(--amber);display:block;font-size:.75rem}
@keyframes fu{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(9px)}}

/* ═══════════════════════════════
   PAGE 1 — INTRO STRIP
═══════════════════════════════ */
.intro-strip{background:var(--bg2);border-top:1px solid var(--border2);border-bottom:1px solid var(--border2)}
.intro-grid{max-width:1360px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
.intro-item{padding:3rem 2rem;text-align:center;border-right:1px solid var(--border2);transition:.3s}
.intro-item:last-child{border-right:none}
.intro-item:hover{background:var(--bg3)}
.ii-ic{font-size:2rem;margin-bottom:.8rem}
.ii-name{font-family:var(--dis);font-size:1.1rem;font-weight:400;color:var(--cream);margin-bottom:.3rem}
.ii-desc{font-size:.78rem;color:var(--cream3);line-height:1.6}

/* ═══════════════════════════════
   PAGE 1 — ABOUT PREVIEW
═══════════════════════════════ */
.about-bg{background:var(--bg)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:7rem;align-items:center}
.about-imgs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.about-imgs img{width:100%}
.about-imgs img:first-child{grid-row:span 2;height:100%}
.about-quote{background:var(--bg3);border-left:3px solid var(--amber);padding:1.8rem;margin:2rem 0;font-family:var(--dis);font-size:1.2rem;font-style:italic;color:var(--cream2);line-height:1.6}
.about-quote cite{display:block;font-family:var(--body);font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--amber);font-style:normal;margin-top:.8rem}

/* ═══════════════════════════════
   PAGE 2 — MENU
═══════════════════════════════ */
.menu-bg{background:var(--bg2)}
.menu-tabs{display:flex;gap:0;border-bottom:1px solid var(--border2);margin-bottom:3.5rem;flex-wrap:wrap}
.mtab{padding:.85rem 2rem;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--cream3);background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer;transition:.25s}
.mtab.on{color:var(--amber);border-bottom-color:var(--amber)}
.mtab:hover{color:var(--cream)}
.menu-pane{display:none}
.menu-pane.on{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.mc{background:var(--bg3);border:1px solid var(--border2);overflow:hidden;cursor:pointer;transition:.4s}
.mc:hover{border-color:var(--border);transform:translateY(-4px);box-shadow:0 20px 48px rgba(0,0,0,.4)}
.mc-img{aspect-ratio:4/3;overflow:hidden;position:relative}
.mc-img img{width:100%;height:100%;transition:transform .7s}
.mc:hover .mc-img img{transform:scale(1.08)}
.mc-tag{position:absolute;top:.8rem;left:.8rem;background:var(--amber);color:var(--bg);padding:.2rem .6rem;font-size:.52rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
.mc-body{padding:1.5rem}
.mc-cat{font-size:.55rem;letter-spacing:.3em;text-transform:uppercase;color:var(--amber);margin-bottom:.3rem}
.mc-name{font-family:var(--dis);font-size:1.3rem;font-weight:400;color:var(--cream);margin-bottom:.4rem}
.mc-desc{font-size:.78rem;color:var(--cream3);line-height:1.7;margin-bottom:1rem}
.mc-foot{display:flex;justify-content:space-between;align-items:center;padding-top:1rem;border-top:1px solid var(--border2)}
.mc-price{font-family:var(--dis);font-size:1.4rem;color:var(--amber)}
.mc-add{font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);font-weight:600;transition:.2s}
.mc-add:hover{letter-spacing:.25em}

/* MENU MODAL */
#mModal{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:500;display:none;align-items:center;justify-content:center;padding:1.5rem}
#mModal.on{display:flex}
.mm-box{background:var(--bg3);border:1px solid var(--border);max-width:700px;width:100%;max-height:90vh;overflow-y:auto;position:relative;animation:mmIn .35s cubic-bezier(.22,1,.36,1)}
@keyframes mmIn{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
.mm-img{width:100%;height:280px;object-fit:cover}
.mm-body{padding:2.5rem}
.mm-tag{display:inline-block;background:var(--amber);color:var(--bg);padding:.2rem .7rem;font-size:.52rem;letter-spacing:.2em;text-transform:uppercase;font-weight:700;margin-bottom:1rem}
.mm-cat{font-size:.55rem;letter-spacing:.3em;text-transform:uppercase;color:var(--amber);margin-bottom:.3rem}
.mm-name{font-family:var(--dis);font-size:2rem;font-weight:400;color:var(--cream);margin-bottom:.6rem}
.mm-desc{font-size:.9rem;color:var(--cream3);line-height:1.9;margin-bottom:1.5rem}
.mm-metas{display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem}
.mm-meta{background:var(--bg2);border:1px solid var(--border2);padding:.5rem 1rem;font-size:.75rem;color:var(--cream3)}
.mm-meta strong{color:var(--amber);display:block;font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;margin-bottom:.2rem}
.mm-price-row{display:flex;align-items:center;justify-content:space-between;padding-top:1.5rem;border-top:1px solid var(--border2)}
.mm-price{font-family:var(--dis);font-size:2.2rem;color:var(--amber)}
.mm-close{position:absolute;top:1rem;right:1rem;background:rgba(0,0,0,.5);border:none;color:#fff;width:36px;height:36px;font-size:1.1rem;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center}
.mm-close:hover{background:var(--amber);color:var(--bg)}

/* ARABIC TOGGLE */
.lang-btn{position:fixed;bottom:5rem;right:2rem;z-index:60;background:var(--bg3);border:1px solid var(--border);color:var(--amber);padding:.5rem 1rem;font-size:.65rem;font-weight:600;letter-spacing:.15em;cursor:pointer;transition:.25s}
.lang-btn:hover{background:var(--amber);color:var(--bg)}
[dir="rtl"] body{font-family:'Noto Sans Arabic',var(--body)}
[dir="rtl"] .nav-w,[dir="rtl"] .inn,[dir="rtl"] .ft{direction:rtl}
[dir="rtl"] .aline{margin-right:0;margin-left:auto}
[dir="rtl"] .aline.c{margin-inline:auto}
[dir="rtl"] .timeline{padding-left:0;padding-right:3rem}
[dir="rtl"] .timeline::before{left:auto;right:.7rem}
[dir="rtl"] .tl-dot{left:auto;right:-2.3rem}
[dir="rtl"] .tl-year,[dir="rtl"] .tl-title,[dir="rtl"] .tl-desc{text-align:right}
[dir="rtl"] .about-quote{border-left:none;border-right:3px solid var(--amber)}
[dir="rtl"] .mm-close{right:auto;left:1rem}

/* ═══════════════════════════════
   PAGE 2 — ORIGINS
═══════════════════════════════ */
.origins-bg{background:var(--bg)}
.origins-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:4rem}
.origin-card{position:relative;overflow:hidden;cursor:pointer}
.origin-card img{width:100%;aspect-ratio:3/4;transition:transform .7s}
.origin-card:hover img{transform:scale(1.06)}
.origin-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,13,10,.95) 0%,rgba(15,13,10,.2) 60%,transparent 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:2rem}
.origin-flag{font-size:1.5rem;margin-bottom:.5rem}
.origin-country{font-family:var(--dis);font-size:1.6rem;font-weight:400;color:#fff;margin-bottom:.2rem}
.origin-alt{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--amber)}
.origin-desc{font-size:.78rem;color:rgba(255,255,255,.55);margin-top:.5rem;line-height:1.6;max-height:0;overflow:hidden;transition:max-height .4s}
.origin-card:hover .origin-desc{max-height:80px}

/* ═══════════════════════════════
   PAGE 3 — EXPERIENCE / ATMOSPHERE
═══════════════════════════════ */
.atm-bg{background:var(--bg3)}
.atm-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:7rem;align-items:center}
.atm-imgs{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto;gap:8px}
.atm-img-big{grid-column:span 2;overflow:hidden}
.atm-img-big img{width:100%;height:300px}
.atm-img-sm{overflow:hidden}
.atm-img-sm img{width:100%;height:200px}
.atm-feats{display:flex;flex-direction:column;gap:.8rem;margin:2rem 0}
.atf{display:flex;align-items:center;gap:1rem;padding:.9rem 1.2rem;background:var(--bg2);border:1px solid var(--border2);transition:.25s}
.atf:hover{border-color:var(--border);background:var(--bg4)}
.atf-ic{font-size:1.3rem;flex-shrink:0}
.atf-t{font-weight:500;font-size:.85rem;color:var(--cream);margin-bottom:.1rem}
.atf-d{font-size:.75rem;color:var(--cream3)}

/* ═══════════════════════════════
   PAGE 3 — GALLERY (masonry)
═══════════════════════════════ */
.gallery-bg{background:var(--bg)}
.g-filter{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;margin-bottom:3rem}
.gfb{padding:.45rem 1.4rem;border:1px solid var(--border);background:transparent;color:var(--cream3);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:.25s;font-family:var(--body)}
.gfb.on,.gfb:hover{background:var(--amber);border-color:var(--amber);color:var(--bg)}
.g-masonry{columns:3;gap:8px}
.g-tile{break-inside:avoid;margin-bottom:8px;position:relative;overflow:hidden;cursor:pointer}
.g-tile img{width:100%;display:block;transition:transform .6s}
.g-tile:hover img{transform:scale(1.06)}
.g-ov{position:absolute;inset:0;background:rgba(15,13,10,.75);display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:.3s}
.g-tile:hover .g-ov{opacity:1}
.g-ov-t{font-family:var(--dis);font-size:1.1rem;font-style:italic;color:#fff}
.g-ov-c{font-size:.55rem;letter-spacing:.3em;text-transform:uppercase;color:var(--amber);margin-top:.3rem}

/* lightbox */
#lb{position:fixed;inset:0;background:rgba(0,0,0,.97);z-index:999;display:none;align-items:center;justify-content:center}
#lb.on{display:flex}
#lb img{max-width:90vw;max-height:85vh;object-fit:contain}
#lbX{position:absolute;top:1.5rem;right:2rem;color:#fff;font-size:1.8rem;background:none;border:none;cursor:pointer;opacity:.4;transition:.2s}
#lbX:hover{opacity:1;color:var(--amber)}
#lbP,#lbN{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.07);border:none;color:#fff;font-size:1.5rem;padding:1rem;cursor:pointer;transition:.2s}
#lbP{left:1rem}#lbN{right:1rem}
#lbP:hover,#lbN:hover{background:var(--amber);color:var(--bg)}
#lbCap{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);font-family:var(--dis);font-size:1rem;color:#fff;font-style:italic;opacity:.5}

/* ═══════════════════════════════
   PAGE 4 — OUR STORY
═══════════════════════════════ */
.story-bg{background:var(--bg2)}
.story-hero{position:relative;height:55vh;min-height:400px;overflow:hidden;margin-bottom:6rem}
.story-hero img{width:100%;height:100%}
.story-hero-ov{position:absolute;inset:0;background:rgba(15,13,10,.7);display:flex;align-items:center;justify-content:center;text-align:center}
.story-hero-ov h2{font-family:var(--dis);font-size:clamp(3rem,6vw,6rem);font-weight:300;color:#fff;line-height:1.1}
.story-hero-ov h2 em{color:var(--amber2);font-style:italic}
.timeline{display:flex;flex-direction:column;gap:0;position:relative;padding-left:3rem;margin:4rem 0}
.timeline::before{content:'';position:absolute;left:.7rem;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,var(--amber),transparent)}
.tl-item{position:relative;padding-bottom:3.5rem}
.tl-dot{position:absolute;left:-2.3rem;top:.2rem;width:14px;height:14px;border-radius:50%;background:var(--amber);border:3px solid var(--bg2)}
.tl-year{font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--amber);margin-bottom:.3rem}
.tl-title{font-family:var(--dis);font-size:1.4rem;font-weight:400;color:var(--cream);margin-bottom:.4rem}
.tl-desc{font-size:.85rem;color:var(--cream3);line-height:1.8;max-width:560px}
.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:4rem}
.team-card{text-align:center}
.team-img{aspect-ratio:3/4;overflow:hidden;margin-bottom:1rem}
.team-img img{width:100%;height:100%;transition:transform .6s}
.team-card:hover .team-img img{transform:scale(1.05)}
.team-name{font-family:var(--dis);font-size:1.1rem;font-weight:400;color:var(--cream);margin-bottom:.2rem}
.team-role{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--amber)}
.team-bio{font-size:.78rem;color:var(--cream3);margin-top:.5rem;line-height:1.6}

/* ═══════════════════════════════
   PAGE 5 — VISIT US
═══════════════════════════════ */
.visit-bg{background:var(--bg)}
.visit-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:start}
.hours-table{width:100%;border-collapse:collapse;margin-top:1.5rem}
.hours-table tr{border-bottom:1px solid var(--border2)}
.hours-table td{padding:.9rem .5rem;font-size:.85rem}
.hours-table td:first-child{color:var(--cream3)}
.hours-table td:last-child{color:var(--cream);font-weight:500;text-align:right}
.hours-table tr.today td{color:var(--amber)}
.map-box{background:var(--bg3);border:1px solid var(--border2);overflow:hidden}
.map-img{width:100%;height:280px}
.map-info{padding:2rem}
.loc-items{display:flex;flex-direction:column;gap:1.2rem;margin-top:1.5rem}
.loc-item{display:flex;align-items:flex-start;gap:1rem}
.loc-ic{width:36px;height:36px;background:rgba(212,134,14,.1);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
.loc-lbl{font-size:.57rem;letter-spacing:.2em;text-transform:uppercase;color:var(--amber);margin-bottom:.2rem}
.loc-val{font-size:.85rem;color:var(--cream3);line-height:1.6}
/* events */
.events-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:4rem}
.ev-card{background:var(--bg2);border:1px solid var(--border2);overflow:hidden;transition:.3s}
.ev-card:hover{border-color:var(--border);transform:translateY(-3px)}
.ev-img{aspect-ratio:16/9;overflow:hidden}
.ev-img img{width:100%;height:100%;transition:transform .6s}
.ev-card:hover .ev-img img{transform:scale(1.06)}
.ev-body{padding:1.5rem}
.ev-date{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--amber);margin-bottom:.4rem}
.ev-name{font-family:var(--dis);font-size:1.2rem;font-weight:400;color:var(--cream);margin-bottom:.4rem}
.ev-desc{font-size:.78rem;color:var(--cream3);line-height:1.7}

/* ═══════════════════════════════
   PAGE 5 — REVIEWS
═══════════════════════════════ */
.rev-bg{background:var(--bg3)}
.rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:4rem;grid-auto-rows:1fr}
.rev-card{background:var(--bg2);border:1px solid var(--border2);padding:2.2rem;transition:.35s;position:relative}
.rev-card:hover{border-color:var(--border);transform:translateY(-4px)}
.rev-qs{position:absolute;top:1.2rem;right:1.5rem;font-size:3rem;font-family:var(--dis);color:var(--amber);opacity:.2;line-height:1}
.rev-stars{color:var(--amber);letter-spacing:.08em;margin-bottom:1rem;font-size:.9rem}
.rev-text{font-family:var(--dis);font-size:1.05rem;font-style:italic;font-weight:300;color:var(--cream3);line-height:1.82;margin-bottom:1.5rem;padding-left:1rem;border-left:2px solid var(--border)}
.rev-auth{display:flex;align-items:center;gap:.9rem}
.rev-av{width:42px;height:42px;border-radius:50%;overflow:hidden;border:1px solid var(--border);flex-shrink:0}
.rev-av img{width:100%;height:100%}
.rev-name{font-weight:500;font-size:.85rem;color:var(--cream)}
.rev-src{font-size:.68rem;color:var(--cream3)}

/* ═══════════════════════════════
   PAGE 6 — CONTACT
═══════════════════════════════ */
.contact-bg{background:var(--bg)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:start}
.fg{display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.3rem}
.fl{font-size:.57rem;letter-spacing:.22em;text-transform:uppercase;color:var(--amber)}
.fi{background:var(--bg2);border:1px solid var(--border2);color:var(--cream);font-size:.9rem;font-weight:300;padding:.8rem 1.1rem;outline:none;transition:.2s}
.fi::placeholder{color:var(--cream3)}
.fi:focus{border-color:var(--amber)}
.f-row2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.fta{resize:vertical;min-height:120px}
.fsub{width:100%;background:var(--amber);color:var(--bg);border:none;padding:1.1rem;font-size:.7rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase;cursor:pointer;transition:.25s}
.fsub:hover{background:var(--amber2)}
.f-ok{display:none;text-align:center;padding:3.5rem 1rem;color:var(--cream3);font-family:var(--dis);font-size:1.4rem;font-style:italic}
/* newsletter */
.nl-bg{background:var(--amber);padding:5rem 2.5rem;text-align:center}
.nl-h{font-family:var(--dis);font-size:clamp(2rem,4vw,3.5rem);color:var(--bg);font-weight:400;margin-bottom:.8rem}
.nl-p{font-size:.9rem;color:rgba(15,13,10,.65);max-width:420px;margin:0 auto 2rem;line-height:1.8}
.nl-form{display:flex;gap:0;max-width:480px;margin:0 auto;flex-wrap:wrap}
.nl-input{flex:1;min-width:200px;padding:1rem 1.4rem;background:rgba(255,255,255,.25);border:none;font-family:var(--body);font-size:.9rem;color:var(--bg);outline:none}
.nl-input::placeholder{color:rgba(15,13,10,.5)}
.nl-btn{background:var(--bg);color:var(--amber);border:none;padding:1rem 2rem;font-size:.65rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:.25s;white-space:nowrap}
.nl-btn:hover{background:var(--bg2)}

/* ═══════════════════════════════
   CTA SECTION
═══════════════════════════════ */
.cta-sec{position:relative;overflow:hidden;padding:9rem 2.5rem;text-align:center}
.cta-bg{position:absolute;inset:0;background-size:cover;background-position:center;filter:brightness(.25)}
.cta-in{position:relative;z-index:1}
.cta-h{font-family:var(--dis);font-size:clamp(2.5rem,5.5vw,5.5rem);color:#fff;font-weight:300;line-height:1.1;margin-bottom:1rem}
.cta-h em{font-style:italic;color:var(--amber2)}
.cta-p{font-size:.95rem;color:rgba(255,255,255,.45);max-width:420px;margin:0 auto 2.5rem;line-height:1.9}

/* ═══════════════════════════════
   STATS STRIP
═══════════════════════════════ */
.stats-bg{background:var(--bg3);border-top:1px solid var(--border2);border-bottom:1px solid var(--border2)}
.stats-grid{max-width:1360px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr)}
.st{padding:3.5rem 1rem;text-align:center;border-right:1px solid var(--border2)}
.st:last-child{border-right:none}
.stn{font-family:var(--dis);font-size:3.5rem;font-weight:300;color:var(--amber);line-height:1;display:block}
.stl{font-size:.57rem;letter-spacing:.25em;text-transform:uppercase;color:var(--cream3);margin-top:.5rem}

/* ═══════════════════════════════
   FOOTER
═══════════════════════════════ */
footer{background:var(--bg2);border-top:1px solid var(--border2);padding:5rem 2.5rem 0}
.ft{max-width:1360px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3.5rem;padding-bottom:4rem;border-bottom:1px solid var(--border2)}
.f-logo-wrap{display:flex;align-items:center;gap:.7rem;margin-bottom:1rem}
.f-logo-name{font-family:var(--dis);font-size:1.3rem;color:var(--amber);letter-spacing:.08em}
.f-desc{font-size:.82rem;color:var(--cream3);line-height:1.9;max-width:240px}
.f-socs{display:flex;gap:.5rem;margin-top:1.6rem}
.fsoc{width:34px;height:34px;border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--cream3);transition:.2s}
.fsoc:hover{border-color:var(--amber);color:var(--amber)}
.fc-t{font-size:.57rem;letter-spacing:.3em;text-transform:uppercase;color:var(--cream);margin-bottom:1.2rem}
.fc-ul{list-style:none;display:flex;flex-direction:column;gap:.65rem}
.fc-ul a{font-size:.82rem;color:var(--cream3);transition:.2s}
.fc-ul a:hover{color:var(--amber)}
.fb{max-width:1360px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;padding:1.5rem 0;font-size:.67rem;letter-spacing:.08em;color:var(--cream3)}

/* ═══════════════════════════════
   RESPONSIVE
═══════════════════════════════ */
@media(max-width:1100px){
  .about-grid,.atm-grid,.visit-grid,.contact-grid{grid-template-columns:1fr;gap:4rem}
